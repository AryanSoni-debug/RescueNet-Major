# Copy to .env (never commit it). Everything here is optional.

# --- Administrators (read ONCE, on first start, then locked in the database) ---
# Up to 5 addresses. To change them later you must delete rescuenet.db on purpose.
RESCUENET_ADMIN_EMAILS=admin@rescuenet.demo,dispatcher@rescuenet.demo
# Initial password for the admins. Must meet the password policy. If unset, a strong random
# password is generated per admin and written to ADMIN_CREDENTIALS.txt (and printed at startup).
# RESCUENET_ADMIN_PASSWORD=

# --- AI (all optional; the app works without them) ---
# Deeper photo checks + free-form first-aid answers via Claude (recommended):
# ANTHROPIC_API_KEY=
# RESCUENET_CLAUDE_MODEL=claude-haiku-5-5
# Or Hugging Face (AI-image detector + CLIP scene check + chat model):
# HF_TOKEN=
# RESCUENET_AI_DETECTOR_MODEL=umm-maybe/AI-image-detector
# RESCUENET_SCENE_MODEL=openai/clip-vit-base-patch32
# RESCUENET_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Demo / deployment ---
# Allow the same test photo in several reports (otherwise reused photos are rejected):
# RESCUENET_ALLOW_DUPLICATE_IMAGES=1
# Behind HTTPS or a reverse proxy:
# RESCUENET_COOKIE_SECURE=1
# RESCUENET_TRUST_PROXY=1
# RESCUENET_DEBUG=1   (enables /docs)
